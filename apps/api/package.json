{
  "name": "@valueskins/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:deploy": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:deploy": "node dist/db/seed.js",
    "job": "tsx src/jobs/run.ts",
    "job:deploy": "node dist/jobs/run.js"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@valueskins/shared": "workspace:*",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.0.1",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "resend": "^6.30.0",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "msw": "^2.15.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
