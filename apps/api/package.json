{
  "name": "@valueskins/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "echo 'drizzle-kit not wired yet, no schema exists' && exit 0",
    "db:migrate": "echo 'drizzle-kit not wired yet, no schema exists' && exit 0",
    "db:seed": "echo 'no seed script yet' && exit 0"
  },
  "dependencies": {
    "@valueskins/shared": "workspace:*",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
