# Runtime environment: development | staging | production
NODE_ENV=

# Port the Express server listens on
PORT=

# Postgres connection string
DATABASE_URL=

# Postgres connection string used only by the Vitest suite (points at the separate
# valueskins_test database created by docker/init-test-db.sql). Not used at runtime.
# Optional: defaults to empty when omitted.
TEST_DATABASE_URL=

# Origin of the web app, checked as CSRF protection on every mutating request
WEB_ORIGIN=

# Cookie Domain attribute for the session cookie (e.g. .valueskins.com in production, empty locally)
COOKIE_DOMAIN=

# Name of the session cookie (differs per environment, see SPEC section 19)
SESSION_COOKIE_NAME=

# Secret used to sign the OAuth state cookie and other server-side signing
SESSION_SECRET=

# AES-256-GCM key used to encrypt the stored Instagram long-lived token
TOKEN_ENCRYPTION_KEY=

# Meta app id for Instagram API with Instagram Login
INSTAGRAM_APP_ID=

# Meta app secret for Instagram API with Instagram Login
INSTAGRAM_APP_SECRET=

# OAuth redirect URI registered with the Meta app
INSTAGRAM_REDIRECT_URI=

# Meta app secret used to verify signed_request on data-deletion/deauthorize callbacks
META_APP_SECRET=

# Razorpay API key id
RAZORPAY_KEY_ID=

# Razorpay API key secret
RAZORPAY_KEY_SECRET=

# Secret used to verify Razorpay webhook signatures
RAZORPAY_WEBHOOK_SECRET=

# Resend API key for transactional email
RESEND_API_KEY=

# From address for outgoing email (notifications@valueskins.com)
EMAIL_FROM=

# Email transport: console (dev, prints instead of sending) | resend
EMAIL_TRANSPORT=

# Comma-separated Instagram user ids granted admin access. Optional: defaults to empty.
ADMIN_INSTAGRAM_USER_IDS=

# The one address users write to: email footer, reply-to and error copy (REPLACEMENT_PLAN 2.7)
SUPPORT_EMAIL=

# Address disputes and admin alerts are emailed to. Optional: defaults to SUPPORT_EMAIL.
DISPUTE_EMAIL=

# Enables POST /api/dev/login. Must never be true in production (startup check enforces this)
ENABLE_DEV_LOGIN=

# Company legal name shown on generated invoices
COMPANY_LEGAL_NAME=

# Company address shown on generated invoices
COMPANY_ADDRESS=

# Company state, used for GST place-of-supply calculation (CGST+SGST vs IGST)
COMPANY_STATE=

# Company GSTIN shown on generated invoices. Required while GST_RATE_BPS is above 0.
COMPANY_GSTIN=

# SAC code for the commission line item on the GST tax invoice
COMMISSION_SAC_CODE=

# Enables the email-code login path alongside Instagram login. Staging and tests only:
# a startup guard refuses true when NODE_ENV=production.
AUTH_EMAIL_ENABLED=

# GST rate in basis points. Optional: defaults to 1800 (18%). A startup guard requires
# COMPANY_GSTIN while this is above 0.
GST_RATE_BPS=
