# Base URL of the API the web app calls (e.g. http://localhost:4000 locally,
# https://api-staging.valueskins.com on staging)
NEXT_PUBLIC_API_URL=

# Razorpay key id used by Checkout in the browser (publishable, not the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Temporary UI (V0_LAUNCH 2.7): true shows /dev/login. Set to true only where the
# API has ENABLE_DEV_LOGIN=true. A build with this true and NEXT_PUBLIC_API_URL
# pointing at https://api.valueskins.com fails on purpose.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=

# Temporary UI (V0_LAUNCH 2.7): true shows "Sign in with email". Mirrors the API's
# AUTH_EMAIL_ENABLED.
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=
