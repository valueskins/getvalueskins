# Base URL of the API the web app calls (e.g. http://localhost:4000 locally,
# https://api-staging.valueskins.com on staging). In production this is the GitHub Actions
# variable of the same name (docs/DEPLOYMENT.md section 21.6).
NEXT_PUBLIC_API_URL=

# true shows /dev/login. Set to true only where the API has ENABLE_DEV_LOGIN=true.
# A build with this true and NEXT_PUBLIC_API_URL pointing at
# https://api.valueskins.com fails on purpose.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=

# Error reporting to Sentry (errors only; personal data is removed before sending). Optional: leave
# blank to turn it off. The Content-Security-Policy then allows exactly the host in this DSN.
# In production this is the GitHub Actions variable of the same name.
NEXT_PUBLIC_SENTRY_DSN=
